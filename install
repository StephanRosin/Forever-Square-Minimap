#!/usr/bin/env bash
# Copy the addon into a WoW AddOns folder.
#   ./install "<path to>/_forever_/Interface/AddOns"
set -eu
DEST="${1:?usage: ./install <AddOns folder>}"
[ -d "$DEST" ] || { echo "Not a directory: $DEST" >&2; exit 1; }
HERE="$(cd "$(dirname "$0")" && pwd)"
TARGET="$DEST/ForeverSquareMinimap"
rm -rf "$TARGET"
mkdir -p "$TARGET"
# Files listed in the TOC, the TOC itself and the media (our icons; the
# themes' backdrops, ornaments and fonts with their licence in the embedded
# LibForeverThemes); nothing else ships.
cp "$HERE/ForeverSquareMinimap.toc" "$TARGET/"
mkdir -p "$TARGET/Media" "$TARGET/Libs/LibForeverThemes"
cp "$HERE"/Media/*.tga "$TARGET/Media/"
cp -r "$HERE/Libs/LibForeverThemes/Media" "$TARGET/Libs/LibForeverThemes/"
grep -v '^\s*#' "$HERE/ForeverSquareMinimap.toc" | grep -v '^\s*$' | tr -d '\r' | while read -r f; do
    f="${f//\\//}"
    mkdir -p "$TARGET/$(dirname "$f")"
    cp "$HERE/$f" "$TARGET/$f"
done
echo "Installed to $TARGET"
